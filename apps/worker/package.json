{
  "name": "@mandate/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "test": "DATABASE_URL=${DATABASE_URL:-postgres://mandate:mandate@127.0.0.1:5433/mandate_rescue} vitest run --passWithNoTests",
    "adversarial": "node src/adversarial/generate.ts ../../docs/adversarial.md",
    "backtest": "node src/backtest/generate.ts ../../docs/backtest.md",
    "contention": "node src/contention/generate.ts ../../docs/contention.md",
    "batch": "node src/batch/generate.ts ../../docs/results.md",
    "ope": "node src/ope/generate.ts ../../docs/off-policy.md",
    "import:csv": "node src/import/cli.ts",
    "backfill": "node src/backfill/cli.ts"
  },
  "dependencies": {
    "@mandate/core": "workspace:*",
    "@mandate/db": "workspace:*",
    "@anthropic-ai/sdk": "^0.120.0"
  },
  "devDependencies": {
    "vitest": "^3.0.5",
    "@types/pg": "^8.11.10"
  }
}
