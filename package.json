{
  "name": "mandate-rescue",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d && sleep 5 && pnpm db:migrate",
    "db:down": "docker compose down",
    "db:migrate": "node packages/db/migrate.js",
    "dev:api": "pnpm --filter @mandate/api dev",
    "dev:worker": "pnpm --filter @mandate/worker dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "start": "bash scripts/start.sh",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5",
    "@types/node": "^22.10.5"
  }
}
