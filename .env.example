# Razorpay — TEST MODE keys only until Phase 3
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET_TEST=
RAZORPAY_WEBHOOK_SECRET_LIVE=

DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5433/mandate_rescue

# Safety. DRY_RUN=false requires an explicit human action and a merchant with write_enabled.
DRY_RUN=true
KILL_SWITCH=false
BLAST_RADIUS_MAX_ATTEMPTS=50

SECRET_MASTER_KEY=
KILL_SWITCH_RELEASE_TOKEN=

ANTHROPIC_API_KEY=

# Agent provider. Pick one. Precedence: AGENT_PROVIDER, then whichever key is present.
# AGENT_PROVIDER=groq | gemini | cerebras | openrouter | ollama | anthropic | mock
#
# Free options (no card required):
#   GROQ_API_KEY=          console.groq.com/keys          llama-3.3-70b-versatile
#   GEMINI_API_KEY=        aistudio.google.com/apikey     gemini-2.5-flash
#   CEREBRAS_API_KEY=      cloud.cerebras.ai              llama-3.3-70b
#   OPENROUTER_API_KEY=    openrouter.ai/keys             free-tier models
#   AGENT_PROVIDER=ollama  no key, runs locally           ollama pull llama3.1:8b
#
# Paid (needs billing enabled, not just an account):
#   OPENAI_API_KEY=        gpt-4o-mini
#   ANTHROPIC_API_KEY=     claude-haiku-4-5-20251001 by default, not Opus
#
# Override any preset:
# AGENT_BASE_URL=
# AGENT_MODEL=
# AGENT_API_KEY=

# Tests run against their own database so a live dev worker cannot corrupt them.
# TEST_DATABASE_URL=postgres://mandate:mandate@127.0.0.1:5433/mandate_rescue_test

# Gates the actions that can move money: kill switch, write-access consent, demo batch.
# Leave unset for open local development; set it on any deployed instance.
# OPERATOR_PASSPHRASE=
